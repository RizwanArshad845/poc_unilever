{
  "hosting": {
    "target": "unilever",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": ["npm run build"],
    "rewrites": [
      { "source": "/api/scan", "function": { "functionId": "unileverScan", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "unilever",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.local", ".secret.local"]
    }
  ]
}
