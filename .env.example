# Local dev only (npm run dev). Copy to .env.local and fill in. Never prefix with VITE_.
# In production the key comes from Firebase Secret Manager (see README).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional overrides
# GEMINI_MODEL=gemini-3.8-flash
# MATCH_MIN_CONFIDENCE=0.6
